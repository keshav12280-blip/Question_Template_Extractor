  "computed_equations": [
    {
      "step": 1,
      "equation": "For small angular displacement theta, horizontal displacement at distance r is r*theta"
    },

    {
      "step": 2,
      "equation": "Restoring force due to spring = k*r*theta"
    },

    {
      "step": 3,
      "equation": "Restoring torque = k*r^2*theta"
    },

    {
      "step": 4,
      "equation": "In Fig.1 springs are attached at r=l and r=l/2"
    },

    {
      "step": 5,
      "equation": "C1 = k*l^2 + k*(l/2)^2"
    },

    {
      "step": 6,
      "equation": "C1 = (5/4)k*l^2"
    },

    {
      "step": 7,
      "equation": "In Fig.2 both springs are attached at r=l/2"
    },

    {
      "step": 8,
      "equation": "C2 = 2*k*(l/2)^2"
    },

    {
      "step": 9,
      "equation": "C2 = (1/2)k*l^2"
    },

    {
      "step": 10,
      "equation": "f1/f2 = sqrt(C1/C2)"
    },

    {
      "step": 11,
      "equation": "f1/f2 = sqrt((5/4)/(1/2))"
    },

    {
      "step": 12,
      "equation": "f1/f2 = sqrt(5/2)"
    }
