  "constraints": [
    {
      "type": "horizontal_velocity_constant",
      "expression": "vx = u*cos(theta)"
    },

    {
      "type": "kinetic_energy_relation",
      "expression": "KE = (1/2)m(vx^2 + vy^2)"
    },

    {
      "type": "highest_point_condition",
      "expression": "vy = 0 at point B"
    },

    {
      "type": "energy_conservation",
      "expression": "KE_A = KE_C"
    }
  ],

  "computed_equations": [
    {
      "step": 1,
      "equation": "Initial kinetic energy = (1/2)mu^2 = K"
    },

    {
      "step": 2,
      "equation": "At highest point, velocity = u*cos(60)"
    },

    {
      "step": 3,
      "equation": "KE_B = (1/2)m(u*cos60)^2"
    },

    {
      "step": 4,
      "equation": "KE_B = K/4"
    },

    {
      "step": 5,
      "equation": "Difference = K - K/4 = 3K/4"
    },

    {
      "step": 6,
      "equation": "Ratio = 3:4"
    }
