  "answer_template": {
    "formula": "KE_B = K*cos^2(theta)",
    "expanded_formula": "KE_B = K*cos^2(60)",
    "correct_answer": "3:4"
  },

  "solution_explanation": [
    "Initial kinetic energy is K.",
    "At highest point vertical velocity becomes zero.",
    "Only horizontal component remains.",
    "Horizontal velocity = u*cos60.",
    "Thus KE at B = K/4.",
    "At C kinetic energy again becomes K.",
    "Difference = K - K/4 = 3K/4.",
    "Required ratio = 3:4."
