  "question_template": {
    "text": "An object is projected with kinetic energy @s0 from a point @s1 at an angle @s2 with the horizontal. The ratio of the difference in kinetic energies at points @s3 and @s4 to that at point @s1, in the absence of air friction is:"
  },

  "generated_values": {
    "@s0": "K",
