  "answer_template": {

    "formula": "sin(i) = mu*sin(A - c)",

    "expanded_formula": "sin(i) = 2*sin(50 - 30)",

    "correct_answer": "30deg"
  },

  "solution_explanation": [

    "Critical angle c = sin^(-1)(1/mu)",

    "For mu = 2, c = 30 deg",

    "Using prism relation: r1 + r2 = A",

    "r1 + 30 = 50",

    "r1 = 20 deg",

    "Using Snell's law:",

    "sin(i) = mu*sin(r1)",

    "sin(i) = 2*sin(20)",

